# ==============================================================================
# CITE RAG SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate for your environment:
#   cp .env.example .env
#
# NOTE: End-user LLM queries and document figure captioning use Bring-Your-Own-Key
# (BYOK) passed dynamically in request headers (X-LLM-Key and X-LLM-Model).
# Those keys are NEVER stored in this file, never persisted to disk or databases,
# and never logged.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave empty if running local unauthenticated Qdrant
QDRANT_API_KEY=
CHUNKS_COLLECTION=chunks_collection
DOCUMENTS_COLLECTION=documents_collection

# ------------------------------------------------------------------------------
# 2. Metadata Database (MongoDB)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=rag_kb

# ------------------------------------------------------------------------------
# 3. Embedding & Reranking Services
# ------------------------------------------------------------------------------
# Self-hosted BGE-M3 dense + sparse embedding and cross-encoder reranker
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_DIM=1024
RERANKER_SERVICE_URL=http://localhost:8002
INFERENCE_SERVICE_TIMEOUT_S=30.0

# ------------------------------------------------------------------------------
# 4. Upload & Ingestion Controls
# ------------------------------------------------------------------------------
UPLOAD_DIR=/tmp/rag_uploads
MAX_FILE_SIZE_MB=200
MAX_PAGE_COUNT=2000
MAX_CONCURRENT_JOBS=4
INGESTION_QUEUE_MAXSIZE=100
PAGE_PARALLELISM=4

# ------------------------------------------------------------------------------
# 5. ClamAV Antivirus Scanning (Optional)
# ------------------------------------------------------------------------------
VIRUS_SCAN_ENABLED=false
CLAMD_HOST=localhost
CLAMD_PORT=3310

# ------------------------------------------------------------------------------
# 6. Chunking & Summarization Parameters
# ------------------------------------------------------------------------------
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_RATIO=0.125
DOC_SUMMARY_MIN_TOKENS=150
DOC_SUMMARY_MAX_TOKENS=250
DOC_SUMMARY_SOURCE_MAX_CHARS=40000
EMBEDDING_BATCH_SIZE=64

# ------------------------------------------------------------------------------
# 7. Document Parsing & Multimodal OCR (Docling)
# ------------------------------------------------------------------------------
DOCLING_OCR_ENABLED=true
DOCLING_PICTURE_IMAGES_SCALE=2.0

# ------------------------------------------------------------------------------
# 8. Document Routing & Hybrid Search Retrieval (Qdrant RRF)
# ------------------------------------------------------------------------------
# Document routing similarity threshold (set to 0.1 for mock embeddings, 0.35 for real BGE-M3)
DOC_ROUTING_SIMILARITY_FLOOR=0.35
DOC_ROUTING_TOP_K=30
CHUNK_FUSION_TOP_K=50
RRF_K=60
DEFAULT_TOP_K=10

# ------------------------------------------------------------------------------
# 9. Multi-Hop Reasoning Loop & Context Budgeting
# ------------------------------------------------------------------------------
# Maximum number of iterative sub-question refinement hops
HOP_CAP=4

# Token budget for final prompt context (keeps prompt within optimal attention region)
CONTEXT_TOKEN_BUDGET=1800
TOKEN_COUNT_ENCODING=cl100k_base
CITATION_SNIPPET_MAX_CHARS=280

# ------------------------------------------------------------------------------
# 10. Default LLM Client Settings (LiteLLM)
# ------------------------------------------------------------------------------
DEFAULT_LLM_MODEL=openai/gpt-4o-mini
LLM_REQUEST_TIMEOUT_S=60.0

# ------------------------------------------------------------------------------
# 11. Offline Evaluation Judge (Optional)
# ------------------------------------------------------------------------------
# Dedicated model & API key used strictly for offline Ragas-style evaluation metrics
EVAL_JUDGE_MODEL=openai/gpt-4o-mini
EVAL_JUDGE_API_KEY=your_eval_judge_api_key_here
